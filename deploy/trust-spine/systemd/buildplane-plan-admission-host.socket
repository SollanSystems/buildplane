[Unit]
Description=Buildplane protected plan-admission socket

[Socket]
ListenStream=/run/buildplane/authority-host/plan-admission-v1.sock
Accept=no
Service=buildplane-plan-admission-host.service
SocketUser=root
SocketGroup=buildplane-operator
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target
