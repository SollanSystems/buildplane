[Unit]
Description=Buildplane protected promotion-execution socket

[Socket]
ListenStream=/run/buildplane/authority-host/promotion-execution-v1.sock
Accept=no
Service=buildplane-promotion-execution-host.service
SocketUser=root
SocketGroup=buildplane-operator
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target
