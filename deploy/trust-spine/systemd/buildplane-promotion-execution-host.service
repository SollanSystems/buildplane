[Unit]
Description=Buildplane protected promotion-execution authority
Requires=buildplane-promotion-execution-host.socket
After=buildplane-promotion-execution-host.socket
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/libexec/buildplane/buildplane-promotion-execution-host
User=buildplane-authority
Group=buildplane-authority
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/etc/buildplane/authority-host
ReadOnlyPaths=/var/lib/buildplane/authority/keys
InaccessiblePaths=/var/lib/buildplane/authority/keys/operator
ReadWritePaths=/var/lib/buildplane/authority/ledger
ReadWritePaths=/var/lib/buildplane/authority/repository
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077
StandardOutput=null
StandardError=journal
